@model backendconfigconecta.Controllers.CreateStudentViewModel
@{
    ViewData["Title"] = "Novo Aluno";
    Layout = null;
}
<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>EduSys — Novo Aluno</title>
    <link rel="stylesheet" href="~/css/geral.css" />
    <style>
        :root {
            --brand-lime: #1EB53A;
            --brand-lime-dark: #008744;
            --font-sans: 'Segoe UI', system-ui, sans-serif;
            --font-mono: 'SF Mono', 'Fira Code', monospace;
            --bg-card: rgba(255, 255, 255, 0.95);
            --border: rgba(30, 181, 58, 0.15);
            --text-100: #1a2e1a;
            --text-200: #1a3d1a;
            --text-400: #4a7a4a;
            --text-600: #6a9a6a;
            --shadow-md: 0 4px 20px rgba(0, 0, 0, 0.08);
        }
        body { background: linear-gradient(165deg, #051211 0%, #0B2B28 50%, #051211 100%); font-family: var(--font-sans); min-height: 100vh; display: flex; align-items: center; justify-content: center; }
        .form-card { background: var(--bg-card); border-radius: 5px; padding: 36px; width: 100%; max-width: 420px; box-shadow: var(--shadow-md); }
        .form-title { font-size: 20px; font-weight: 700; color: var(--text-100); margin-bottom: 24px; }
        .form-title span { color: var(--brand-lime); }
        .field { display: flex; flex-direction: column; gap: 6px; margin-bottom: 16px; }
        .field label { font-family: var(--font-mono); font-size: 10px; letter-spacing: 0.15em; text-transform: uppercase; color: var(--text-600); }
        .field input { padding: 10px 14px; border-radius: 5px; border: 1px solid var(--border); font-size: 14px; outline: none; color: var(--text-200); background: rgba(30,181,58,0.04); transition: border-color 0.2s; }
        .field input:focus { border-color: rgba(118,192,87,0.35); }
        .field .validation { font-size: 11px; color: #dc3545; }
        .btn-primary { background: linear-gradient(135deg, #76C057 0%, #3C8F40 100%); color: #0D2B18; font-weight: 700; border: none; padding: 12px; border-radius: 5px; cursor: pointer; font-size: 11px; letter-spacing: 0.1em; width: 100%; margin-top: 8px; }
        .btn-primary:hover { background: linear-gradient(135deg, #A8D582 0%, #76C057 100%); }
        .back-link { color: var(--brand-lime); text-decoration: none; font-size: 12px; display: inline-flex; align-items: center; gap: 6px; margin-bottom: 20px; }
        .back-link:hover { color: var(--brand-lime-dark); }
        .validation-summary { background: rgba(220,53,69,0.1); border: 1px solid rgba(220,53,69,0.2); border-radius: 5px; padding: 12px 16px; margin-bottom: 16px; font-size: 12px; color: #dc3545; }
        .validation-summary ul { margin: 0; padding-left: 16px; }
    </style>
</head>
<body>
    <div class="form-card">
        <a href="@Url.Action("Students")" class="back-link">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="14" height="14"><path d="M19 12H5M12 19l-7-7 7-7"/></svg>
            Voltar
        </a>
        <h1 class="form-title">Novo <span>Aluno</span></h1>

        <form method="post">
            @Html.AntiForgeryToken()

            @if (!ViewData.ModelState.IsValid)
            {
                <div class="validation-summary">
                    @Html.ValidationSummary(true)
                </div>
            }

            <div class="field">
                <label>Nome</label>
                <input asp-for="Nome" placeholder="Nome completo" />
                <span asp-validation-for="Nome" class="validation"></span>
            </div>
            <div class="field">
                <label>Email</label>
                <input asp-for="Email" placeholder="email@provedor.com" type="email" />
                <span asp-validation-for="Email" class="validation"></span>
            </div>
            <div class="field">
                <label>Senha</label>
                <input asp-for="Password" type="password" placeholder="Mínimo 6 caracteres" />
                <span asp-validation-for="Password" class="validation"></span>
            </div>
            <button type="submit" class="btn-primary">CRIAR ALUNO</button>
        </form>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/jquery-validation/dist/jquery.validate.min.js"></script>
    <script src="~/lib/jquery-validation-unobtrusive/dist/jquery.validate.unobtrusive.min.js"></script>
</body>
</html>