@{
    ViewData["Title"] = "Posts";
    Layout = null;
}
@model List<backendconfigconecta.Models.Post>
<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>EduSys — Posts</title>
    <link rel="stylesheet" href="~/css/geral.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" />
    <style>
        :root {
            --brand-lime: #1EB53A;
            --brand-lime-dark: #008744;
            --brand-lime-light: #31f301;
            --brand-green: #1EB53A;
            --brand-green-mid: #008744;
            --brand-green-dark: #004438;
            --brand-teal: #08785B;

            --font-sans: 'Segoe UI', system-ui, sans-serif;
            --font-mono: 'SF Mono', 'Fira Code', monospace;

            --bg-deep: #f4faf4;
            --bg-mid: #eaf5ea;
            --bg-card: rgba(255, 255, 255, 0.95);
            --bg-card-alt: rgba(244, 250, 244, 0.85);
            --bg-row: rgba(30, 181, 58, 0.05);
            --bg-input: rgba(30, 181, 58, 0.04);

            --teal-400: #08785B;
            --teal-600: #065a45;
            --teal-800: #043d2e;

            --lime-300: #1EB53A;
            --lime-400: #1EB53A;
            --lime-600: #008744;
            --lime-700: #006633;
            --lime-900: #004438;

            --border:       rgba(30, 181, 58, 0.15);
            --border-strong:rgba(30, 181, 58, 0.30);
            --border-hover: rgba(30, 181, 58, 0.40);
            --border-lime:  rgba(30, 181, 58, 0.25);

            --text-100: #1a2e1a;
            --text-200: #1a3d1a;
            --text-400: #4a7a4a;
            --text-600: #6a9a6a;
            --text-800: #9aba9a;

            --shadow-sm: 0 2px 8px rgba(0, 0, 0, 0.06);
            --shadow-md: 0 4px 20px rgba(0, 0, 0, 0.08);
            --shadow-lg: 0 8px 32px rgba(0, 0, 0, 0.12);
            --glow-teal: 0 0 16px rgba(8, 120, 91, 0.15);
            --glow-lime: 0 0 16px rgba(30, 181, 58, 0.20);

            --radius-sm: 4px;
            --radius-md: 5px;
            --radius-lg: 5px;
            --radius-xl: 5px;
            --radius-full: 9999px;
        }

        body { background: #FFFFFF; font-family: var(--font-sans); }
        body::before { display: none; }

        .posts-page { min-height: 100vh; display: flex; flex-direction: column; }

        /* Topbar */
        .posts-topbar {
            position: sticky; top: 0; z-index: 10;
            display: flex; align-items: center; gap: 16px;
            padding: 16px 20px;
            background: rgba(0, 0, 0, 0.14);
            border-bottom: 1px solid var(--border);
        }

        .posts-topbar .back-link {
            display: inline-flex; align-items: center; gap: 10px;
            font-family: var(--font-mono); font-size: 13px;
            letter-spacing: 0.14em; color: var(--text-600);
            text-decoration: none; transition: color 0.2s;
        }
        .posts-topbar .back-link:hover { color: var(--lime-300); }
        .posts-topbar .back-link svg { width: 18px; height: 18px; }

        .posts-topbar-sep { width: 1px; height: 18px; background: var(--border); }

        .posts-page-title {
            font-size: 16px; font-weight: 700;
            color: var(--text-100); letter-spacing: 0.04em;
        }
        .posts-page-title span { color: var(--lime-400); }

        /* Content */
        .posts-content {
            flex: 1; padding: 36px 32px;
            max-width: 860px; width: 100%;
            margin: 0 auto; position: relative; z-index: 1;
        }

        .posts-header {
            display: flex; align-items: center;
            justify-content: space-between; margin-bottom: 28px;
        }

        .posts-count {
            font-family: var(--font-mono); font-size: 10px;
            letter-spacing: 0.15em; color: var(--text-600);
        }

        /* ── POST CARD REDESIGNED ── */
        .post-card {
            background: var(--bg-card);
            border: 1px solid var(--border);
            border-radius: 5px;
            margin-bottom: 24px;
            box-shadow: var(--shadow-sm);
            overflow: hidden;
            transition: border-color 0.22s, box-shadow 0.22s, transform 0.22s;
        }
        .post-card:hover {
            border-color: var(--border-strong);
            box-shadow: var(--shadow-md);
            transform: translateY(-3px);
        }

        .post-card-image-wrap {
            position: relative;
            width: 100%;
            height: 320px;
            overflow: hidden;
            background: linear-gradient(135deg, #eaf5ea 0%, #d4edd4 100%);
        }

        .post-card-image-wrap img {
            width: 100%; height: 100%;
            object-fit: cover;
            transition: transform 0.5s ease;
        }
        .post-card:hover .post-card-image-wrap img {
            transform: scale(1.05);
        }

        .post-card-image-overlay {
            position: absolute; inset: 0;
            background: linear-gradient(to top, rgba(255,255,255,0.85) 0%, rgba(255,255,255,0.1) 60%, transparent 100%);
            pointer-events: none;
        }

        .post-card-image-badge {
            position: absolute; top: 16px; right: 16px;
            font-family: var(--font-mono); font-size: 9px;
            letter-spacing: 0.12em; text-transform: uppercase;
            padding: 5px 12px; border-radius: 9999px;
            background: rgba(255,255,255,0.85);
            backdrop-filter: blur(8px);
            border: 1px solid var(--border);
            color: var(--text-600);
        }

        .post-card-image-placeholder {
            width: 100%; height: 100%;
            display: flex; align-items: center; justify-content: center;
            font-size: 48px; color: var(--text-800);
        }

        .post-card-body {
            padding: 22px 24px;
        }

        .post-card-meta {
            display: flex; align-items: center; gap: 12px;
            margin-bottom: 10px;
        }

        .post-card-date {
            font-family: var(--font-mono); font-size: 9px;
            letter-spacing: 0.12em; text-transform: uppercase;
            color: var(--text-600);
            display: flex; align-items: center; gap: 5px;
        }
        .post-card-date i { font-size: 10px; color: var(--lime-400); }

        .post-card-title {
            font-size: 20px; font-weight: 700;
            color: var(--text-100); line-height: 1.3;
            margin-bottom: 10px;
        }

        .post-card-desc {
            font-size: 13.5px; color: var(--text-400);
            line-height: 1.7;
            display: -webkit-box;
            -webkit-line-clamp: 3;
            -webkit-box-orient: vertical;
            overflow: hidden;
            max-height: 69px;
            transition: max-height 0.3s;
        }
        .post-card-desc.expanded {
            -webkit-line-clamp: unset;
            max-height: none;
        }

        .post-card-actions {
            display: flex; gap: 10px;
            padding-top: 16px; margin-top: 16px;
            border-top: 1px solid var(--border);
        }

        .post-btn {
            font-family: var(--font-mono); font-size: 10px;
            letter-spacing: 0.14em; text-transform: uppercase;
            padding: 9px 18px; border-radius: 5px;
            cursor: pointer; transition: all 0.2s;
            display: inline-flex; align-items: center; gap: 6px;
        }

        .post-btn-primary {
            background: linear-gradient(135deg, #76C057 0%, #3C8F40 100%);
            color: #0D2B18; font-weight: 700;
            border: 1px solid rgba(118,192,87,0.25);
            box-shadow: 0 2px 8px rgba(118,192,87,0.15);
        }
        .post-btn-primary:hover {
            background: linear-gradient(135deg, #A8D582 0%, #76C057 100%);
            box-shadow: 0 4px 16px rgba(118,192,87,0.28);
        }

        .post-btn-delete {
            background: transparent;
            color: #ff6b6b;
            border: 1px solid rgba(255,107,107,0.25);
        }
        .post-btn-delete:hover {
            background: rgba(255,107,107,0.1);
            border-color: #ff6b6b;
        }

        .no-posts {
            text-align: center; padding: 60px 20px;
            color: var(--text-600);
        }
        .no-posts i { font-size: 48px; display: block; margin-bottom: 14px; opacity: 0.4; }
    </style>
</head>
<body>
<div class="posts-page">

    <!-- Topbar -->
    <header class="posts-topbar">
        <a class="back-link" asp-controller="Aluno" asp-action="Index">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M19 12H5M12 19l-7-7 7-7"/>
            </svg>
            Voltar ao início
        </a>
        <div class="posts-topbar-sep"></div>
        <div class="navbar-brand">
            <img src="~/css/imagens/logo_conecta 2.png" alt="Logo Conecta" style="height:32px; width:auto;" />
        </div>
        <div class="posts-topbar-sep"></div>
        <p class="posts-page-title">POSTS<span>.</span></p>
        <div style="margin-left:auto;">
            <a asp-controller="Post" asp-action="Create" class="btn btn-primary" style="padding:10px 22px;font-size:13px;">
                <i class="fas fa-plus"></i> Novo Post
            </a>
        </div>
    </header>

    <!-- Content -->
    <main class="posts-content">

        <div class="posts-header">
            <div>
                <h2 style="font-size:20px;font-weight:700;color:var(--text-100);">Suas Publicações</h2>
                <p style="font-size:12px;color:var(--text-600);margin-top:3px;">Anotações, dúvidas e projetos compartilhados</p>
            </div>
            <span class="posts-count">@(Model?.Count ?? 0) POSTS</span>
        </div>

        @if (Model == null || !Model.Any())
        {
            <div class="no-posts">
                <i class="fas fa-pen-fancy"></i>
                <p>Nenhum post publicado ainda.</p>
            </div>
        }
        else
        {
            @foreach (var post in Model)
            {
                <article class="post-card">
                    <div class="post-card-image-wrap">
                        @if (post.ImagemData != null && !string.IsNullOrEmpty(post.ImagemTipo))
                        {
                            <img src="data:@post.ImagemTipo;base64,@Convert.ToBase64String(post.ImagemData)" alt="@post.Titulo" />
                        }
                        else
                        {
                            <div class="post-card-image-placeholder">
                                <i class="fas fa-image"></i>
                            </div>
                        }
                        <div class="post-card-image-overlay"></div>
                        <span class="post-card-image-badge">
                            <i class="fas fa-calendar" style="margin-right:4px;"></i>@post.DataCriacao.ToString("dd MMM yyyy")
                        </span>
                    </div>
                    <div class="post-card-body">
                        <div class="post-card-meta">
                            <span class="post-card-date">
                                <i class="fas fa-clock"></i> @post.DataCriacao.ToString("HH:mm")
                            </span>
                        </div>
                        <h3 class="post-card-title">@post.Titulo</h3>
                        <p class="post-card-desc" id="desc-@post.Id">@post.Descricao</p>
                        <div class="post-card-actions">
                            <button class="post-btn post-btn-primary" onclick="verMais(@post.Id)">
                                <i class="fas fa-eye"></i> Ver mais
                            </button>
                            <form asp-controller="Post" asp-action="Delete" asp-route-id="@post.Id" method="post" style="display:inline;" onsubmit="return confirm('Excluir este post permanentemente?')">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="post-btn post-btn-delete">
                                    <i class="fas fa-trash"></i> Excluir
                                </button>
                            </form>
                        </div>
                    </div>
                </article>
            }
        }

    </main>
</div>

<script>
    function verMais(id) {
        var desc = document.getElementById('desc-' + id);
        if (desc) {
            desc.classList.toggle('expanded');
            var btn = desc.closest('.post-card-body').querySelector('.post-btn-primary');
            if (desc.classList.contains('expanded')) {
                btn.innerHTML = '<i class="fas fa-eye-slash"></i> Ver menos';
            } else {
                btn.innerHTML = '<i class="fas fa-eye"></i> Ver mais';
            }
        }
    }
</script>
</body>
</html>
